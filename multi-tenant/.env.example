# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=mtadmin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=multitenant
POSTGRES_PORT=5432

# Full connection string used by NestJS + Prisma (public schema)
DATABASE_URL="postgresql://mtadmin:change_me_in_production@localhost:5432/multitenant?schema=public"

# Separate URL for tests (points at test DB)
DATABASE_URL_TEST="postgresql://mtadmin:change_me_in_production@localhost:5432/multitenant_test?schema=public"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_secure_random_string_min_64_chars
JWT_REFRESH_SECRET=replace_with_different_secure_random_string_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:9000,http://localhost:3000

# ── File uploads ─────────────────────────────────────────────────────────────
FILE_UPLOAD_DIR=./uploads

# ── Tenant resolution ─────────────────────────────────────────────────────────
# Platform base domain (used to extract subdomain)
PLATFORM_DOMAIN=platform.local
