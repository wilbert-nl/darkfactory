# Auth.js
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# OAuth providers (optional — leave blank to disable that button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Database
DATABASE_URL="file:./dev.db"

# Anthropic — for paste categorization & title/summary
ANTHROPIC_API_KEY=""

# Email (verification links). In dev, if SMTP_HOST is empty, links are logged to console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Stash <noreply@stash.local>"
